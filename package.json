{
  "name": "photo-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "@biomejs/biome": "2.4.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  },
  "scripts": {
    "dev": "bun run build:shared && concurrently -n web,admin,api -c cyan,magenta,green \"bun run --cwd apps/web dev\" \"bun run --cwd apps/admin dev\" \"bun run --cwd apps/api start:dev\"",
    "build": "bun run build:shared && bun run --cwd apps/web build && bun run --cwd apps/admin build && bun run --cwd apps/api build",
    "build:shared": "bun run --cwd packages/shared build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "bun run build:shared && bun run --cwd apps/web typecheck && bun run --cwd apps/admin typecheck && bun run --cwd apps/api typecheck",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "bun run --cwd apps/api prisma:migrate",
    "db:generate": "bun run --cwd apps/api prisma:generate",
    "db:seed": "bun run --cwd apps/api prisma:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "concurrently": "^9.2.1",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "trustedDependencies": [
    "@prisma/engines",
    "argon2",
    "msgpackr-extract",
    "prisma"
  ]
}
