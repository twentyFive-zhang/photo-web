NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://photo:photo@localhost:5432/photo?schema=public
REDIS_URL=redis://localhost:6379

SITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173/admin
API_URL=http://localhost:3001
# 后台专辑二维码用的前台地址；未设置时用当前访问的 hostname 拼 :3000（dev 局域网扫码够用）
# VITE_PUBLIC_BASE_URL=https://jiangliuer.com
# "手机管理"二维码用的后台地址；未设置时用当前访问的 hostname 拼 :5173/admin
# VITE_PUBLIC_ADMIN_BASE_URL=https://jiangliuer.com/admin
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-password

SWAGGER_ENABLED=true
SWAGGER_USER=admin
SWAGGER_PASSWORD=replace-this-password

BAIDU_APP_KEY=
BAIDU_APP_SECRET=
BAIDU_REDIRECT_URI=http://localhost:3001/api/admin/baidu/callback
# 应用名（创建应用时填写的名称，即网盘 /我的应用数据/{应用名}/ 的目录名）；网盘镜像同步用
BAIDU_APP_NAME=

COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
# 生产配 CDN 绝对地址；默认 /media 同源相对路径（dev 由 web/admin 代理到 API）
# CDN_BASE_URL=https://cdn.example.com/media
STORAGE_DIR=var/storage

# ===== P2 统一登录（OIDC，身份源 = Authentik；键名以 apps/api/src/config/env.ts 为准） =====
# P3 起这些值由 admin-gate bootstrap 写入 ~/homelab/admin-gate/.env（键名带 PHOTOWEB_ 前缀），
# webup 映射到本文件；映射表见 ~/homelab/admin-gate/DESIGN.md §4
# issuer 必须带「尾斜杠」——Authentik 2026.8 per-provider discovery 原样返回尾斜杠，
# openid-client 严格比对 issuer，去掉尾斜杠会 issuer mismatch 登录全挂
OIDC_ISSUER=http://id.localhost/application/o/photo-web/
OIDC_CLIENT_ID=photo-web
# 密钥不进模板：由 admin-gate bootstrap 生成（对应 PHOTOWEB_OIDC_CLIENT_SECRET）
OIDC_CLIENT_SECRET=
# groups claim 随 profile scope 下发（Authentik 2026.8 无字面 groups scope）
OIDC_SCOPES=openid profile
# 回调落在 API 直达地址：admin SPA(:5173) 经 vite proxy 调 API，session cookie 按
# host 作用域（localhost，端口无关），:3001 回调写下的 cookie 对 :5173 同样生效
OIDC_REDIRECT_URI=http://localhost:3001/api/auth/callback
# OIDC 登录准入组（userinfo groups claim）
OIDC_ADMIN_GROUP=photo-web-admin
# 会话回查（fail-closed）：用 service account token 查 Authentik Core API，确认用户仍
# active 且仍在准入组；Authentik 异常时 502，用户失效时 401（对应 PHOTOWEB_AUTHENTIK_TOKEN）
AUTHENTIK_API_URL=http://id.localhost/api/v3
AUTHENTIK_API_TOKEN=
