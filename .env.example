NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://photo:photo@localhost:5432/photo?schema=public
REDIS_URL=redis://localhost:6379

SITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173/admin
API_URL=http://localhost:3001
# 后台专辑二维码用的前台地址；未设置时用当前访问的 hostname 拼 :3000（dev 局域网扫码够用）
# VITE_PUBLIC_BASE_URL=https://jiangliuer.com
# "手机管理"二维码用的后台地址；未设置时用当前访问的 hostname 拼 :5173/admin
# VITE_PUBLIC_ADMIN_BASE_URL=https://jiangliuer.com/admin
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-password

SWAGGER_ENABLED=true
SWAGGER_USER=admin
SWAGGER_PASSWORD=replace-this-password

BAIDU_APP_KEY=
BAIDU_APP_SECRET=
BAIDU_REDIRECT_URI=http://localhost:3001/api/admin/baidu/callback

COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
# 生产配 CDN 绝对地址；默认 /media 同源相对路径（dev 由 web/admin 代理到 API）
# CDN_BASE_URL=https://cdn.example.com/media
STORAGE_DIR=var/storage
