generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PUBLIC
  UNLISTED
}

// 两档展示变体（ADR 0005）：large(2560) 档已移除，展示上限为 display(1600)
enum PhotoVariant {
  THUMB
  DISPLAY
}

enum ImageFormat {
  WEBP
  JPEG
}

enum ImportSource {
  BAIDU
  LOCAL
}

enum ImportStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum ImportItemStatus {
  PENDING
  DOWNLOADING
  PROCESSING
  SUCCEEDED
  SKIPPED
  FAILED
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Album {
  id           String     @id @default(cuid())
  publicId     String     @unique
  shareToken   String     @unique
  title        String
  description  String?
  coverPhotoId String?    @unique
  visibility   Visibility @default(UNLISTED)
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  coverPhoto Photo?       @relation("AlbumCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  // 成员关系（ADR 0006）：专辑由显式成员组成，与网盘目录无关
  members    AlbumPhoto[]

  @@index([visibility, publishedAt])
}

/// 成员关系（ADR 0006）：照片与专辑多对多，sortOrder 持有专辑内顺序。
/// 一张照片可同时属于多个专辑（各自独立排序），也可不属于任何专辑。
model AlbumPhoto {
  albumId   String
  photoId   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([albumId, photoId])
  @@index([photoId])
  @@index([albumId, sortOrder])
}

model Photo {
  id          String   @id @default(cuid())
  publicId    String   @unique
  title       String?
  caption     String?
  originalKey String   @unique
  sha256      String   @unique
  width       Int
  height      Int
  exif        Json?
  // 已推送到百度网盘的文件 fs_id（字符串存 uint64 防精度丢失）；null = 未同步
  netdiskFsId String?  @unique
  // 网盘文件完整路径——仅作可修正缓存（管理员可在网盘 App 内自由移动/改名，
  // 扫描按 fsId 刷新），目录结构不承载任何系统语义（ADR 0006）
  netdiskPath String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coverOfAlbum  Album?           @relation("AlbumCover")
  memberships   AlbumPhoto[]
  renditions    PhotoRendition[]
  tags          PhotoTag[]
  featured      FeaturedPhoto?
  importItems   ImportItem[]
  pushFailure   NetdiskPushFailure?
}

model PhotoRendition {
  id      String       @id @default(cuid())
  photoId String
  variant PhotoVariant
  format  ImageFormat
  key     String       @unique
  width   Int
  height  Int
  bytes   Int

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, variant, format])
}

model Tag {
  id     String     @id @default(cuid())
  name   String     @unique
  photos PhotoTag[]
}

model PhotoTag {
  photoId String
  tagId   String

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([photoId, tagId])
  @@index([tagId])
}

model FeaturedPhoto {
  photoId   String   @id
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([sortOrder])
}

/// 导入任务（ADR 0006 收编两段式第一步）：把网盘文件登记为照片，
/// 不绑定专辑；专辑组成在专辑编辑页挑图完成。
model ImportJob {
  id        String       @id @default(cuid())
  source    ImportSource
  status    ImportStatus @default(QUEUED)
  total     Int          @default(0)
  completed Int          @default(0)
  failed    Int          @default(0)
  skipped   Int          @default(0)
  error     String?
  payload   Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  items ImportItem[]

  @@index([status, createdAt])
}

model ImportItem {
  id           String           @id @default(cuid())
  jobId        String
  sourceFileId String
  filename     String
  status       ImportItemStatus @default(PENDING)
  error        String?
  photoId      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  job   ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  photo Photo?    @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@unique([jobId, sourceFileId])
  @@index([jobId])
  @@index([status])
}

model BaiduCredential {
  id           String   @id @default("singleton")
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// 推送网盘重试耗尽后的持久化失败记录（重推成功或人工忽略后清除；
/// 一张照片最多一条，重复失败覆盖更新，全量推送兜底不再让失败只留在 stdout）
model NetdiskPushFailure {
  id          String   @id @default(cuid())
  photoId     String   @unique
  publicId    String
  filename    String
  // 百度 errno；网络/存储等非百度错误为 null
  errno       Int?
  error       String
  attemptedAt DateTime @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([attemptedAt])
}

model SiteSetting {
  id                String   @id @default("singleton")
  siteName          String   @default("江流儿摄影")
  siteDescription   String   @default("")
  about             String   @default("")
  contactEmail      String?
  wechatQrKey       String?
  socialLinks       Json?
  // 每日凌晨自动扫描网盘增量（下行同步）
  netdiskDailyScan  Boolean  @default(true)
  // 最近一次下行扫描报告（ pendingCount/pendingFiles/pathsRefreshed/masterLost 等）
  netdiskScanReport Json?
  // 托管文件登记（直接上传到网盘、不属于照片流程的文件 fsId/path 列表，
  // 下行扫描据此跳过；见 ADR 0004）
  netdiskManagedFiles Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
