{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prisma:generate": "bun run --env-file=../../.env prisma generate",
    "prisma:migrate": "bun run --env-file=../../.env prisma migrate dev",
    "prisma:deploy": "bun run --env-file=../../.env prisma migrate deploy",
    "prisma:seed": "bun run --env-file=../../.env prisma/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "^6.7.1",
    "@photo/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.1",
    "bullmq": "^6.4.2",
    "connect-redis": "^10.0.0",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "exifr": "^7.1.3",
    "express-session": "^1.19.0",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "6.19.3",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.2"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "argon2",
    "msgpackr-extract",
    "prisma",
    "sharp"
  ]
}
